{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RewardTracker.Infrastructure.Services.RewardAutomationService": "Information"
    }
  },
  "AllowedHosts": "*",
  "Bot": {
    "Headless": false,
    "ArtifactsPath": "bot-artifacts",
    "NavigationTimeoutMs": 45000,
    "ActionTimeoutMs": 15000,
    "BalanceTimeoutMs": 30000,
    "LoginWindowSeconds": 180,
    "BingSearchCount": 25,
    "BingMaxSearches": 30,
    "BingPointsPerSearch": 3,
    "BingSkipCompletedSearches": true,
    "BingDailySet": true,
    "BingDailySetQuizzes": true,
    "BingQuizTimeoutMs": 90000,
    "BingClaimPoints": true
  }
}
