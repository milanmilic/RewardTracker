@page "/admin"
@using RewardTracker.Core.Entities
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Administracija Sajtova</PageTitle>

<h1>Upravljanje Reward Sajtovima</h1>
<p class="text-muted">Podaci se učitavaju iz PostgreSQL baze preko API-ja.</p>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Dodaj novi sajt</h5>
                <div class="mb-3">
                    <label>Ime sajta:</label>
                    <input @bind="newSite.Name" class="form-control" placeholder="Npr. Microsoft Bing" />
                </div>
                <div class="mb-3">
                    <label>URL:</label>
                    <input @bind="newSite.Url" class="form-control" placeholder="https://..." />
                </div>
                <div class="form-check mb-3">
                    <input @bind="newSite.IsActive" type="checkbox" class="form-check-input" id="isActiveCheck">
                    <label class="form-check-label" for="isActiveCheck">Aktivan</label>
                </div>
                <button class="btn btn-primary" @onclick="AddSite">Sačuvaj sajt</button>
            </div>
        </div>
    </div>
</div>

<h3>Lista sajtova</h3>
@if (sites == null)
{
    <p><em>Učitavanje...</em></p>
}
else
{
    <table class="table table-hover table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Ime</th>
                <th>URL</th>
                <th>Status</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @if (sites.Count == 0)
            {
                <tr><td colspan="5" class="text-center">Nema unetih sajtova u bazi.</td></tr>
            }
            @foreach (var site in sites)
            {
                <tr>
                    <td>@site.Id</td>
                    <td><strong>@site.Name</strong></td>
                    <td><a href="@site.Url" target="_blank">@site.Url</a></td>
                    <td>
                        @if (site.IsActive) { <span class="badge bg-success">Aktivan</span> }
                        else { <span class="badge bg-secondary">Neaktivan</span> }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-info me-2" href="/admin/site/@site.Id/accounts">Nalozi</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteSite(site.Id)">Obriši</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RewardSite>? sites;
    private RewardSite newSite = new() { IsActive = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadSites();
    }

    private async Task LoadSites()
    {
        sites = await Http.GetFromJsonAsync<List<RewardSite>>("api/rewardsites");
    }

    private async Task AddSite()
    {
        if (!string.IsNullOrWhiteSpace(newSite.Name))
        {
            var response = await Http.PostAsJsonAsync("api/rewardsites", newSite);
            if (response.IsSuccessStatusCode)
            {
                await LoadSites(); // Osvazi tabelu iz baze
                newSite = new() { IsActive = true }; // Reset forme
            }
        }
    }

    private async Task DeleteSite(int id)
    {
        var response = await Http.DeleteAsync($"api/rewardsites/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadSites(); // Osvazi tabelu iz baze
        }
    }
}
